# Copy to .env on the Pi and set all three secrets. Do not commit .env.
OPENAI_API_KEY=replace_me
OPENCLAW_GATEWAY_TOKEN=replace_with_random_token
LELAMP_CONTROL_TOKEN=replace_with_another_random_token
LELAMP_REMOTE_TOKEN=replace_with_a_third_random_token
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
AGENT_BACKEND=pi
PI_AGENT_URL=http://127.0.0.1:18792
PI_AGENT_TOKEN=replace_with_pi_agent_token
PI_AGENT_MAX_TOKENS=256
# 精简运行提示词；设为空则恢复 IDENTITY/SOUL/AGENTS 三份原文。
PI_AGENT_PROMPT_FILE=AGENT_RUNTIME.md
# 保留最近完整对话轮数（含工具结果）；0 恢复不限轮数。
PI_AGENT_HISTORY_TURNS=6
# 动态时间放到本轮输入尾部，固定前缀便于缓存；0 恢复旧方式。
PI_AGENT_STABLE_PREFIX=1
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_AGENT_ID=lelamp
OPENCLAW_MODEL=openclaw/lelamp
OPENCLAW_MAX_TOKENS=512
LELAMP_CONTROL_BIND=127.0.0.1
LELAMP_CONTROL_PORT=18790
LELAMP_REMOTE_BIND=0.0.0.0
LELAMP_REMOTE_PORT=18791
RPI_WS281X_DRIVER_PATH=
ASR_WS_URL=ws://192.168.40.209:6006
TTS_URL=http://192.168.40.209:8200/v1/tts/stream
TTS_BACKEND=edge
TTS_FALLBACK_BACKEND=none
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+10%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_READY_WAIT_SECONDS=0.15
EDGE_TTS_CONNECT_TIMEOUT_SECONDS=3.0
EDGE_TTS_RECEIVE_TIMEOUT_SECONDS=30.0
EDGE_TTS_RETRY_COUNT=1
EDGE_TTS_RETRY_TIMEOUT_SECONDS=3.0
KWS_MODEL_DIR=kws_models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
KWS_KEYWORDS_FILE=kws_models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/keywords_lao_deng.txt
KWS_NUM_THREADS=1
KWS_SCORE=1.5
KWS_THRESHOLD=0.12
# KWS 使用的声道：mean、0 或 1；VAD/ASR 不受影响。
KWS_AUDIO_CHANNEL=mean
ARECORD_DEVICE=hw:seeed2micvoicec,0
APLAY_DEVICE=plughw:seeed2micvoicec,0
APLAY_VOLUME_PERCENT=110
VAD_MODE=silero
VAD_MODEL_PATH=vad_models/silero_vad.onnx
VAD_MODEL_THRESHOLD=0.25
VAD_NUM_THREADS=1
VAD_MODEL_MIN_SILENCE_SECONDS=1.5
VAD_MODEL_MIN_SPEECH_SECONDS=0.05
BARGE_IN_ENABLED=1
BARGE_IN_DEBUG=0
BARGE_IN_AEC_CHANNEL=0
BARGE_IN_AEC_DELAY_MS=80
BARGE_IN_AEC_LEVEL=low
BARGE_IN_PRE_ROLL_SECONDS=0.5
BARGE_IN_IDLE_VAD_THRESHOLD=0.35
BARGE_IN_IDLE_MIN_SPEECH_SECONDS=0.15
BARGE_IN_MOTION_KEYWORDS_FILE=lelamp/voice/keywords_interrupt.txt
BARGE_IN_MOTION_KWS_THRESHOLD=0.15
BARGE_IN_MOTION_KWS_SCORE=0.5
BARGE_IN_MOTION_RELEASE_MS=300
VAD_START_RMS_THRESHOLD=0.008
VAD_CONTINUE_RMS_THRESHOLD=0.008
VAD_NOISE_MULTIPLIER=1.8
VAD_PRE_ROLL_SECONDS=1.0
VAD_CAPTURE_WARMUP_SECONDS=0.5
VAD_SILENCE_SECONDS=1.2
VAD_START_TIMEOUT_SECONDS=5.0
VAD_MAX_SECONDS=15
VOICE_DEBUG=1
VOICE_DEBUG_DIR=voice_debug
VOICE_DIAGNOSTIC_DIR=voice_debug/vad_tests
VAD_DIAGNOSTIC_CALIBRATION_SECONDS=1.0
CONVERSATION_IDLE_SECONDS=15
CONVERSATION_HISTORY_TURNS=6
